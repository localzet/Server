{
  "name": "localzet/server",
  "description": "High-performance asynchronous event-driven server for PHP.",
  "type": "library",
  "keywords": [
    "event-loop",
    "asynchronous",
    "server",
    "http",
    "websocket",
    "tcp",
    "udp"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "issues": "https://github.com/localzet/Server/issues",
    "source": "https://github.com/localzet/Server",
    "docs": "https://server.localzet.com"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "suggest": {
    "revolt/event-loop": "Fiber-based event loop backend and non-blocking Timer::sleep().",
    "localzet/events": "Optional Localzet lifecycle event bus integration.",
    "ext-event": "Native libevent backend.",
    "ext-ev": "Native libev backend.",
    "ext-sockets": "Socket tuning and zero-downtime hot-upgrade descriptor passing.",
    "ext-redis": "Redis-backed HTTP sessions.",
    "ext-pcntl": "Multi-process supervision and hot-upgrade on Unix.",
    "ext-posix": "Unix process, signal and privilege management.",
    "ext-swoole": "Optional native Swoole coroutine event backend.",
    "ext-swow": "Optional native Swow coroutine event backend.",
    "mongodb/mongodb": "MongoDB-backed HTTP sessions."
  },
  "autoload": {
    "psr-4": {
      "localzet\\": "",
      "localzet\\Server\\": "src/"
    },
    "files": [
      "Helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Localzet\\Server\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11 || ^12",
    "phpstan/phpstan": "^2.1",
    "revolt/event-loop": "^1.0"
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "test": "php tests/smoke.php",
    "test:integration": "bash tests/integration.sh",
    "analyze": "phpstan analyse --memory-limit=1G",
    "check": [
      "@lint",
      "@test"
    ],
    "test:all": [
      "@test",
      "@test:gateway",
      "@test:fuzz",
      "@test:memory",
      "@test:revolt",
      "@test:integration"
    ],
    "test:revolt": "php tests/revolt.php",
    "test:gateway": "php tests/gateway_smoke.php && php tests/gateway_host_regression.php && bash tests/gateway_integration.sh",
    "test:fuzz": "php tests/fuzz_smoke.php",
    "test:memory": "php tests/memory_smoke.php",
    "release:audit": "bash tests/release_audit.sh"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "7.0.x-dev"
    }
  }
}
